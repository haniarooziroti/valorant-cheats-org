# Copy to `.env` for local builds (never commit `.env`).

# Canonical site origin — must match production DNS and Cloudflare Worker URL.
PUBLIC_SITE_ORIGIN=https://valorant-cheat.org

# Google Analytics 4 measurement ID (optional).
PUBLIC_GA_MEASUREMENT_ID=

# IndexNow key for search-engine URL submission (optional; build skips ping if empty).
INDEXNOW_KEY=

# Override IndexNow host if it differs from PUBLIC_SITE_ORIGIN (optional).
# INDEXNOW_HOST=valorant-cheat.org
