---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import { organizationSchema, websiteSchema } from '../utils/schema';
import { HERO_CAROUSEL_SLIDES } from '../config/media';
const seo = resolvePageSeo('/');
const heroPoster = HERO_CAROUSEL_SLIDES[0]!.src;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[websiteSchema(), organizationSchema()]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroPoster}
    type="image/webp"
    fetchpriority="high"
    crossorigin="anonymous"
  />
  <HeroSection />
  <FeaturesSection />
  <ProductsSection />
  <ContentSections />
</BaseLayout>
