---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, webPageSchema } from '../../utils/schema';
import { CRUMB } from '../../config/breadcrumbs';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const seo = resolvePageSeo('/blogs/');
const breadcrumbs = [CRUMB.home, { name: 'Blogs', path: '/blogs/' }];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/blogs/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="py-10 md:py-14">
    <div class="mx-auto max-w-2xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="mt-6 text-3xl font-bold uppercase tracking-tight">
        Redirecting — blogs path to the guide index
      </h1>
      <p class="mt-4 text-muted-foreground">
        This blogs path is redirecting readers to the main guide index. Use it when an old bookmark or
        external link still points here instead of the article list.
      </p>
      <h2 class="mt-8 text-xl font-semibold">What you will find on the guide index</h2>
      <p class="mt-3 text-muted-foreground">
        The guide index lists aimbot setup notes, ESP and wallhack walkthroughs, loader fixes, patch-day
        checklists, and checkout articles. Open a post from that list when you need steps before you buy
        or launch modules.
      </p>
      <h2 class="mt-8 text-xl font-semibold">Continue to articles</h2>
      <p class="mt-3 text-muted-foreground">
        Prefer the canonical blog URL for browsing and sharing. This page exists so legacy /blogs/ links
        still resolve with a clear next step.
      </p>
      <p class="mt-6">
        <a class="text-primary underline-offset-4 hover:underline" href="/blog/">
          Open the main guide index at /blog/
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
