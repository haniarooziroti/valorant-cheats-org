---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CRUMB } from '../../../config/breadcrumbs';
import { getAllProductSlugs, getProductPage, productHub } from '../../../data/products';
import { getPageSeoEntry } from '../../../config/pageSeo';
import { pageTitle } from '../../../config/seo';
import { breadcrumbSchema, productSchema } from '../../../utils/schema';
import ProductDetail from '../../../components/ProductDetail.astro';
import ProductRelatedForumsSection from '../../../components/product/ProductRelatedForumsSection.astro';
import { getRelatedForumPostsForProduct } from '../../../data/forumRelated';

export function getStaticPaths() {
  return getAllProductSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const product = getProductPage(slug!);

if (!product) {
  return Astro.redirect(productHub.path);
}

const pagePath = `${productHub.path}${product.slug}/`;
const seoEntry = getPageSeoEntry(pagePath);
const metaTitle = seoEntry?.title ?? pageTitle(product.title);
const metaDescription = seoEntry?.description ?? product.desc;
const relatedForums = getRelatedForumPostsForProduct(product.relatedForumSlugs, 3);
const breadcrumbs = [
  CRUMB.home,
  CRUMB.products,
  { name: product.title, path: pagePath },
];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[
    productSchema({
      name: product.title,
      description: product.desc,
      url: pagePath,
      offerUrl: product.buyUrl,
      image: product.images[0]?.src,
      sku: product.slug,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <ProductDetail product={product} breadcrumbs={breadcrumbs} />
  <ProductRelatedForumsSection posts={relatedForums} productName={product.name} />
</BaseLayout>
