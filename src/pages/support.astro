---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import { CRUMB } from '../config/breadcrumbs';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactSupportSection from '../components/ContactSupportSection.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const seo = resolvePageSeo('/support/');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: t.support.title,
      description: t.support.subtitle,
      url: '/support/',
    }),
    breadcrumbSchema([CRUMB.home, CRUMB.support]),
  ]}
>
  <div class="mx-auto max-w-6xl px-5 pt-8 text-center md:pt-10">
    <Breadcrumbs items={[CRUMB.home, CRUMB.support]} class="justify-center" />
  </div>
  <ContactSupportSection
    titleId="support-page-title"
    showTicketTips
    headerAlign="center"
    class="support-section--centered"
  />
</BaseLayout>
