---
import '../../styles/reviews-page.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PillFilterSelect from '../../components/PillFilterSelect.astro';
import { CRUMB } from '../../config/breadcrumbs';
import { reviewSummary, siteReviews } from '../../data/reviews';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';

const seo = resolvePageSeo('/reviews/');
const breadcrumbs = [CRUMB.home, CRUMB.reviews];

function stars(n: number) {
  return '★'.repeat(n) + '☆'.repeat(5 - n);
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({ name: 'Valorant Cheat reviews', description: seo.description, url: '/reviews/' }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border py-10 md:py-14">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <header class="reviews-hero mt-6">
        <h1 class="text-3xl font-bold uppercase tracking-tight md:text-4xl">Valorant cheat reviews — player feedback</h1>
        <h2 class="mt-4 text-xl font-semibold">Reviews: Valorant Cheat</h2>
        <p class="mt-3 text-muted-foreground">Player feedback on aimbot, ESP, wallhack, setup, and support.</p>
        <div class="reviews-score" aria-label={`${reviewSummary.average} out of 5 from ${reviewSummary.count} reviews`}>
          <strong>{reviewSummary.average} / 5</strong>
          <span class="reviews-stars" aria-hidden="true">★★★★☆</span>
          <span class="text-sm text-muted-foreground">{reviewSummary.count} {reviewSummary.label}</span>
        </div>
      </header>
    </div>
  </section>

  <section class="py-10 md:py-14">
    <div class="mx-auto max-w-6xl px-5">
      <div class="reviews-toolbar reviews-toolbar--centered">
        <PillFilterSelect
          id="review-sort"
          label="Sort by"
          dataAttr="sort"
          defaultValue="newest"
          ariaLabel="Sort reviews"
          options={[
            { value: 'newest', label: 'Newest' },
            { value: 'oldest', label: 'Oldest' },
            { value: 'rating-high', label: 'Highest rating' },
            { value: 'rating-low', label: 'Lowest rating' },
          ]}
        />
        <PillFilterSelect
          id="review-rating-filter"
          label="Filter reviews"
          dataAttr="rating"
          defaultValue="all"
          ariaLabel="Filter by star rating"
          options={[
            { value: 'all', label: 'All ratings' },
            { value: '5', label: '5 stars' },
            { value: '4', label: '4 stars' },
            { value: '3', label: '3 stars' },
            { value: '2', label: '2 stars' },
            { value: '1', label: '1 star' },
          ]}
        />
      </div>

      <div class="reviews-grid" data-review-grid aria-live="polite">
        {siteReviews.map((review) => (
          <article
            class="review-card"
            data-review-card
            data-stars={review.stars}
            data-ts={new Date(review.date).getTime()}
            data-search={`${review.author} ${review.role} ${review.body}`.toLowerCase()}
          >
            <div class="review-card__head">
              <div>
                <strong>u/{review.author}</strong>
                <p class="review-card__meta">{review.role}</p>
              </div>
              <div class="text-right">
                <span class="reviews-stars text-sm" aria-label={`${review.stars} out of 5 stars`}>{stars(review.stars)}</span>
                <p class="review-card__meta">{review.date}</p>
              </div>
            </div>
            <p class="review-card__body">"{review.body}"</p>
          </article>
        ))}
      </div>
      <p class="mt-8 hidden text-center text-muted-foreground" data-review-empty>No reviews match your filters.</p>
    </div>
  </section>

  <script>
    const grid = document.querySelector('[data-review-grid]');
    const sortSelect = document.querySelector<HTMLSelectElement>('[data-pill-filter="sort"]');
    const ratingSelect = document.querySelector<HTMLSelectElement>('[data-pill-filter="rating"]');
    const empty = document.querySelector('[data-review-empty]');

    const cards = () => [...document.querySelectorAll<HTMLElement>('[data-review-card]')];

    const compare = (a: HTMLElement, b: HTMLElement, sort: string) => {
      const tsA = Number(a.getAttribute('data-ts') ?? 0);
      const tsB = Number(b.getAttribute('data-ts') ?? 0);
      const starsA = Number(a.getAttribute('data-stars') ?? 0);
      const starsB = Number(b.getAttribute('data-stars') ?? 0);
      if (sort === 'oldest') return tsA - tsB;
      if (sort === 'rating-high') return starsB - starsA || tsB - tsA;
      if (sort === 'rating-low') return starsA - starsB || tsB - tsA;
      return tsB - tsA;
    };

    const apply = () => {
      if (!grid) return;
      const sort = sortSelect?.value ?? 'newest';
      const rating = ratingSelect?.value ?? 'all';
      const items = cards();

      const sorted = [...items].sort((a, b) => compare(a, b, sort));
      sorted.forEach((el) => grid.appendChild(el));

      let visible = 0;
      items.forEach((card) => {
        const stars = card.getAttribute('data-stars') ?? '';
        const matchRating = rating === 'all' || stars === rating;
        card.classList.toggle('hidden', !matchRating);
        if (matchRating) visible += 1;
      });

      empty?.classList.toggle('hidden', visible > 0);
    };

    sortSelect?.addEventListener('change', apply);
    ratingSelect?.addEventListener('change', apply);
    apply();
  </script>
</BaseLayout>
