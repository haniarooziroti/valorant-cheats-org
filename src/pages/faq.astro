---
import '../styles/faq-page.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllFaqs } from '../data/faq';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../utils/schema';
import { CRUMB } from '../config/breadcrumbs';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';
import SectionHeader from '../components/SectionHeader.astro';

const seo = resolvePageSeo('/faq/');
const breadcrumbs = [CRUMB.home, CRUMB.faq];

const faqs = getAllFaqs();
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: 'Valorant cheat FAQ — loader, pricing, ban risk',
      description:
        'Answers about Valorant PC modules, aim assist, ESP, checkout, and account risk on valorant-cheat.org.',
      url: '/faq/',
    }),
    faqPageSchema(faqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') }))),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} class="justify-center" />
      <div class="mt-6 section-intro">
        <header>
          <p class="section-header__eyebrow">Questions &amp; answers</p>
          <h1 id="faq-page-title" class="section-header__title">Valorant cheat FAQ answers — loader, pricing, ban risk</h1>
          <p class="section-header__subtitle">
            Compatibility, checkout, and setup in plain language. Use search and topic filters below, then open module pages or forum threads for deeper tuning.
          </p>
          <h2 class="mt-4 text-sm font-medium uppercase tracking-wider text-muted-foreground">All questions</h2>
        </header>
      </div>
    </div>
  </section>

  <SiteFaqSection items={faqs} variant="full" titleId="faq-page-list" hideSectionHeader class="faq-page-section" />
</BaseLayout>
