---
import '../styles/faq-page.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllFaqs } from '../data/faq';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../utils/schema';
import { CRUMB } from '../config/breadcrumbs';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';
import SectionHeader from '../components/SectionHeader.astro';

const seo = resolvePageSeo('/faq/');
const breadcrumbs = [CRUMB.home, CRUMB.faq];
const faqCopy = t.faq;

const faqs = getAllFaqs();
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: faqCopy.title,
      description: faqCopy.subtitle,
      url: '/faq/',
    }),
    faqPageSchema(faqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') }))),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} class="justify-center" />
      <div class="mt-6 section-intro">
        <SectionHeader
          eyebrow={faqCopy.eyebrow}
          title={faqCopy.title}
          desc="Compatibility, checkout, and setup in plain language. Use search and topic filters below, then open module pages or blog guides for deeper tuning."
          titleId="faq-page-title"
          centered
          headingLevel="h1"
        />
      </div>
    </div>
  </section>

  <SiteFaqSection items={faqs} variant="full" titleId="faq-page-list" hideSectionHeader class="faq-page-section" />
</BaseLayout>
