---
import '../../styles/blog-pages.css';
import '../../styles/blog-page.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { render } from 'astro:content';
import { resolveBlogCover } from '../../data/blog/covers';
import { getCollectionEntry, getRelatedBlogPosts, loadBlogPosts } from '../../data/blog/loader';
import { pageTitle } from '../../config/seo';
import { getBlogPostSeo } from '../../config/blogSeo';
import { CHECKOUT_URL, OG_DEFAULT_IMAGE, PRODUCT_URL } from '../../config/siteConfig';
import { articleSchema, breadcrumbSchema, faqPageSchema, parseBlogDate } from '../../utils/schema';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogArticleHero from '../../components/blog/BlogArticleHero.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import BlogPostTopBar from '../../components/BlogPostTopBar.astro';
import BlogPricingCallout from '../../components/blog/BlogPricingCallout.astro';
import SiteFaqSection from '../../components/SiteFaqSection.astro';
import Icon from '../../components/icons/Icon.astro';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';

export async function getStaticPaths() {
  const posts = await loadBlogPosts();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const entry = await getCollectionEntry(slug!);
if (!entry) return Astro.redirect('/blog/');

const { Content, headings } = await render(entry);
const dateIso = entry.data.publishDate.toISOString().slice(0, 10);
const readMinutes = entry.data.readMinutes ?? 5;
const cover = resolveBlogCover(slug!, entry.data.featuredImage);
const heroAlt = entry.data.imageAlt || cover.alt || entry.data.title;

const post = {
  slug: slug!,
  tag: entry.data.category,
  title: entry.data.title,
  desc: entry.data.description,
  image: cover.src,
  date: dateIso,
  dateIso,
  readTime: `${readMinutes} min read`,
  body: [],
};

const postPath = `/blog/${post.slug}/`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.title, path: postPath },
];

const related = await getRelatedBlogPosts(post.slug, 3);
const allPosts = await loadBlogPosts();
const order = allPosts.map((p) => p.slug);
const idx = order.indexOf(post.slug);
const prevPost = idx >= 0 && idx < order.length - 1 ? allPosts[idx + 1]! : null;
const nextPost = idx > 0 ? allPosts[idx - 1]! : null;

const published = parseBlogDate(dateIso);
const updated = entry.data.updatedDate
  ? entry.data.updatedDate.toISOString().slice(0, 10)
  : published;

const tocItems = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ level: h.depth === 2 ? 'h2' : 'h3', text: h.text, id: h.slug }));

const postSeo = getBlogPostSeo(post.slug);
const layoutTitle = postSeo?.title ?? pageTitle(post.title, 'Valorant Cheats');
const layoutDescription = postSeo?.description ?? post.desc;
const keywordHeading = postSeo?.keywordHeading;
const ogImage = post.image || OG_DEFAULT_IMAGE;
const productCtaLabel = 'Compare Valorant modules';
const pricingCtaLabel = 'Continue to secure checkout';

const faqItems = (entry.data.faq ?? []).map((item, i) => ({
  id: `blog-faq-${i}`,
  topic: 'all' as const,
  icon: 'faqMore' as const,
  q: item.q,
  a: item.a,
}));

const riskNote =
  'Using third-party software in online games violates the game\'s terms of service and can result in account or hardware bans. No tool is risk-free and we cannot guarantee outcomes. Use at your own risk.';
---

<BaseLayout
  title={layoutTitle}
  description={layoutDescription}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={entry.data.imageAlt || post.title}
  articlePublishedTime={published}
  articleModifiedTime={updated}
  jsonLd={[
    articleSchema({
      name: post.title,
      description: post.desc,
      url: postPath,
      image: ogImage,
      datePublished: published,
      dateModified: updated,
    }),
    breadcrumbSchema(breadcrumbs),
    ...(faqItems.length
      ? [faqPageSchema(faqItems.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a })))]
      : []),
  ]}
>
  <article class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <BlogPostTopBar post={post} class="mt-6" />

      <div class="blog-article__layout mt-4 grid gap-6 lg:grid-cols-[minmax(14rem,16.5rem)_minmax(0,1fr)] lg:items-start lg:gap-8 xl:grid-cols-[17.5rem_minmax(0,1fr)]">
        <BlogSidebar post={post} related={related} tocItems={tocItems} class="order-2 lg:order-1" />

        <div class="order-1 min-w-0 lg:order-2">
          <BlogArticleHero
            src={post.image}
            alt={heroAlt}
            title={post.title}
            category={post.tag}
            slug={post.slug}
          />

          <header class="blog-article__header">
            <div class="flex flex-wrap gap-2">
              <Badge variant="secondary">{post.tag}</Badge>
              <Badge variant="outline">{dateIso}</Badge>
              <Badge variant="outline">{post.readTime}</Badge>
            </div>
            <h1 class="blog-article__title">{post.title}</h1>
            {keywordHeading ? <h2 class="text-lg font-semibold text-foreground">{keywordHeading}</h2> : null}
            <p class="blog-article__byline text-sm text-muted-foreground">Valorant Cheats Team</p>
            <p class="blog-article__lead">{post.desc}</p>
          </header>

          {slug === 'valorant-plans' && <BlogPricingCallout />}

          <Prose class="blog-article__prose prose-headings:scroll-mt-24 max-w-none text-left">
            <Content />
          </Prose>

          <aside class="blog-post-cta not-prose my-10" aria-label="Get Valorant access">
            <div class="blog-post-cta__icon" aria-hidden="true">
              <Icon name="package" size={20} />
            </div>
            <div class="blog-post-cta__body">
              <h2 class="blog-post-cta__title">Get Valorant access</h2>
              <p class="blog-post-cta__text">
                Compare modules on the product hub, then continue to checkout for monthly or lifetime keys.
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                <Button as="a" href={PRODUCT_URL} variant="primary" size="sm">
                  {productCtaLabel}
                </Button>
                <Button as="a" href={CHECKOUT_URL} variant="outline" size="sm">
                  {pricingCtaLabel}
                </Button>
              </div>
            </div>
          </aside>

          {related.length > 0 && (
            <section class="blog-related" aria-labelledby="blog-related-heading">
              <h2 id="blog-related-heading" class="blog-related__title">Related articles</h2>
              <div class="blog-related__grid">
                {related.map((item) => (
                  <BlogCard post={item} />
                ))}
              </div>
            </section>
          )}

          {(prevPost || nextPost) && (
            <nav class="mt-10 grid gap-4 border-t border-border pt-8 sm:grid-cols-2" aria-label="Article pagination">
              {prevPost ? (
                <a class="rounded-xl border border-border p-4 hover:border-primary/40" href={`/blog/${prevPost.slug}/`}>
                  <span class="text-xs text-muted-foreground">Previous</span>
                  <span class="mt-1 block font-semibold">{prevPost.title}</span>
                </a>
              ) : (
                <span />
              )}
              {nextPost ? (
                <a
                  class="rounded-xl border border-border p-4 text-right hover:border-primary/40 sm:col-start-2"
                  href={`/blog/${nextPost.slug}/`}
                >
                  <span class="text-xs text-muted-foreground">Next</span>
                  <span class="mt-1 block font-semibold">{nextPost.title}</span>
                </a>
              ) : null}
            </nav>
          )}

          <p class="blog-risk-note mt-10 text-sm leading-relaxed text-muted-foreground" role="note">
            {riskNote}
          </p>
        </div>
      </div>
    </div>
  </article>

  {faqItems.length > 0 && (
    <SiteFaqSection items={faqItems} titleId={`blog-faq-${post.slug}`} class="border-t border-border bg-muted/20" />
  )}
</BaseLayout>
