---
import '../../styles/blog-page.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadBlogPosts } from '../../data/blog/loader';
import { t } from '../../i18n';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import BlogFilters from '../../components/blog/BlogFilters.astro';
import { Button } from '@/components/starwind/button';
import { PRODUCT_URL } from '../../config/brand';
import { checkoutPath } from '../../config/checkout';
import { ROUTES } from '../../utils/path';

const seo = resolvePageSeo('/blog/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];

const allPosts = await loadBlogPosts();
const articleCount = allPosts.length;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({ name: t.blog.title, description: t.blog.subtitle, url: '/blog/' }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <div class="blog-page">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <header class="blog-page__header">
        <h1 class="blog-page__title">{t.blog.title}</h1>
        <p class="blog-page__intro">{t.blog.subtitle}</p>
      </header>

      <BlogFilters />

      <p class="blog-page__count" data-blog-count aria-live="polite">
        <span data-blog-count-value>{articleCount}</span> {t.blog.articlesCountLabel}
      </p>

      <div id="blog-grid" class="blog-grid" aria-live="polite">
        {allPosts.map((post, index) => (
          <BlogCard post={post} eager={index === 0} />
        ))}
      </div>

      <p id="blog-empty" class="blog-empty hidden" role="status" data-message={t.blog.emptyFilter}>{t.blog.emptyFilter}</p>

      <aside class="blog-buy-strip" aria-labelledby="blog-buy-title">
        <h2 id="blog-buy-title" class="blog-buy-strip__title">Buy MW4: aimbot, ESP &amp; wallhack</h2>
        <p class="blog-buy-strip__text">
          Compare Modern Warfare 4 aim assist, player ESP, radar, and DMZ loot—then pick monthly or lifetime on the product page.
        </p>
        <div class="blog-buy-strip__actions">
          <Button as="a" href={PRODUCT_URL} variant="primary">View MW4 products</Button>
          <Button as="a" href={checkoutPath('mw4')} variant="outline">See pricing</Button>
          <Button as="a" href={ROUTES.forum} variant="outline">Open forum</Button>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
