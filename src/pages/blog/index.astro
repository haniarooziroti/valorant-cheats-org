---
import '../../styles/blog-page.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadBlogPosts } from '../../data/blog/loader';
import { t } from '../../i18n';
import { resolvePageSeo } from '../../config/seo';
import { OG_DEFAULT_IMAGE, BLOG_URL, PRODUCT_URL, CHECKOUT_URL } from '../../config/siteConfig';
import {
  blogSchema,
  breadcrumbSchema,
  collectionPageSchema,
  itemListSchema,
} from '../../utils/schema';
import { blogPostPath } from '../../utils/path';
import { CRUMB } from '../../config/breadcrumbs';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import BlogFilters from '../../components/blog/BlogFilters.astro';
import { Button } from '@/components/starwind/button';

const seo = resolvePageSeo('/blog/');
const breadcrumbs = [CRUMB.home, CRUMB.blog];

const allPosts = await loadBlogPosts();
const articleCount = allPosts.length;
const itemList = itemListSchema(
  allPosts.map((post) => ({ name: post.title, url: blogPostPath(post.slug) })),
);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={OG_DEFAULT_IMAGE}
  themeColor="#0F1923"
  jsonLd={[
    collectionPageSchema({ name: t.blog.title, description: t.blog.subtitle, url: '/blog/' }),
    blogSchema({ name: t.blog.title, description: t.blog.subtitle, url: '/blog/' }),
    breadcrumbSchema(breadcrumbs),
    itemList,
  ]}
>
  <div class="blog-page">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <header class="blog-page__header">
        <p class="blog-page__eyebrow text-sm font-semibold uppercase tracking-wider text-primary">{t.blog.eyebrow}: Valorant Cheats</p>
        <h1 class="blog-page__title">{t.blog.title}</h1>
        <h2 class="mt-3 text-xl font-semibold text-foreground">Blog: Valorant Cheats</h2>
        <p class="blog-page__intro">{t.blog.subtitle}</p>
      </header>

      <div class="blog-controls-wrap">
        <BlogFilters />
        <p class="blog-page__count" data-blog-count aria-live="polite">
          <span data-blog-count-value>{articleCount}</span>{' '}
          <span data-blog-count-label>{t.blog.articlesCountLabel}</span>
        </p>
      </div>

      <div id="blog-grid" class="blog-grid" aria-live="polite">
        {allPosts.map((post, index) => (
          <BlogCard
            post={post}
            eager={index === 0}
            imageAlt={index === 0 ? 'Blog – Valorant Cheat guide cover' : undefined}
          />
        ))}
      </div>

      <div
        id="blog-empty"
        class="blog-empty hidden"
        role="status"
        data-message={t.blog.emptyFilter}
      >
        <p>{t.blog.emptyFilter}</p>
        <button type="button" class="blog-empty__clear" data-blog-clear-filters>
          Clear filters
        </button>
      </div>

      <aside class="blog-buy-strip" aria-labelledby="blog-buy-title">
        <h2 id="blog-buy-title" class="blog-buy-strip__title">Buy Valorant: aimbot, ESP &amp; wallhack</h2>
        <p class="blog-buy-strip__text">
          Compare Valorant aim assist, player ESP, radar and utility tools — then pick monthly or lifetime on the product page.
        </p>
        <div class="blog-buy-strip__actions">
          <Button as="a" href={PRODUCT_URL} variant="primary">Browse the module catalog</Button>
          <Button as="a" href={CHECKOUT_URL} variant="outline">See pricing and plans</Button>
          <Button as="a" href={BLOG_URL} variant="outline">Browse setup guides</Button>
        </div>
      </aside>

      <p class="blog-page__site-links mt-10 text-sm text-muted-foreground">
        <a href="/status/">Live module status</a>
        {' · '}
        <a href="/support/">Loader support desk</a>
        {' · '}
        <a href="/privacy/">How we handle your data</a>
        {' · '}
        <a href="/terms/">Terms of use</a>
        {' · '}
        <a href="/go/valorant/">Secure checkout overview</a>
      </p>
    </div>
  </div>
</BaseLayout>
