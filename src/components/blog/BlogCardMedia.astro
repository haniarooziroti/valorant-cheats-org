---
import ResponsiveImage from '../ResponsiveImage.astro';
import { CARD_IMAGE_SIZES, CARD_IMAGE_WIDTHS } from '../../utils/responsiveImage';
import { blogCardFallbackStyle } from '../../utils/blogCardFallback';

interface Props {
  src: string;
  alt: string;
  title: string;
  category: string;
  slug: string;
  eager?: boolean;
}

const { src, alt, title, category, slug, eager = false } = Astro.props;
const gradient = blogCardFallbackStyle(category, slug);
const hasPhoto = Boolean(src?.trim());
---

<div
  class:list={['blog-card__media', !hasPhoto && 'is-fallback-only']}
  style={`--blog-card-gradient: ${gradient}`}
  data-blog-card-media
  data-has-photo={hasPhoto ? 'true' : undefined}
>
  {
    !hasPhoto && (
      <div class="blog-card__media-fallback" aria-hidden="true">
        <span class="blog-card__media-fallback-cat">{category}</span>
      </div>
    )
  }
  {
    hasPhoto && (
      <ResponsiveImage
        src={src}
        alt={alt}
        width={640}
        height={360}
        widths={CARD_IMAGE_WIDTHS}
        sizes={CARD_IMAGE_SIZES}
        loading={eager ? 'eager' : 'lazy'}
        fetchPriority={eager ? 'high' : undefined}
        class="blog-card__media-img"
        data-blog-card-img
      />
    )
  }
</div>
