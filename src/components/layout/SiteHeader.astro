---
/**
 * Site-wide header (logo, primary nav, Try now checkout CTA, theme toggle).
 * Rendered only from BaseLayout.astro — do not import on individual pages.
 */
import { PRIMARY_NAV, HEADER_CTA_LABEL, PRIMARY_NAV_ICONS } from '../../config/nav';
import { CHECKOUT_URL } from '../../config/siteConfig';
import { SITE_MEDIA } from '../../config/media';
import { t } from '../../i18n';
import { Button } from '@/components/starwind/button';
import AnimatedThemeSwitch from '../AnimatedThemeSwitch.astro';
import {
  Sheet,
  SheetContent,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from '@/components/starwind/sheet';
import Icon from '../icons/Icon.astro';
import SlideRevealButton from '../SlideRevealButton.astro';

interface Props {
  logoAlt?: string;
}

const { logoAlt = 'Aimbot – logo' } = Astro.props;
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50" data-site-header>
  <div class="flex justify-center px-3 pt-3 sm:px-4 sm:pt-4" data-floating-nav>
    <div
      class="pointer-events-auto grid h-14 w-full max-w-[88rem] grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-3 rounded-2xl border border-border/40 bg-background/35 px-3 text-foreground shadow-md shadow-black/5 backdrop-blur-2xl supports-[backdrop-filter]:bg-background/25 dark:border-white/10 dark:bg-background/20 dark:shadow-black/25 sm:px-4 lg:h-[3.75rem] lg:gap-4 lg:px-5"
    >
      <a
        href="/"
        class="inline-flex min-w-0 shrink-0 items-center gap-2 font-[family-name:var(--font-heading)] text-base font-bold tracking-wide sm:text-lg"
        aria-label={t.ui.homeAria}
      >
        <img
          src={SITE_MEDIA.favicon}
          alt={logoAlt}
          width="32"
          height="32"
          class="shrink-0 rounded-md"
          loading="eager"
          decoding="async"
        />
        <span class="hidden truncate sm:inline" aria-hidden="true">Valorant<span class="text-primary">Cheat</span></span>
      </a>

      <nav class="hidden min-w-0 items-center justify-center gap-3 overflow-hidden px-1 lg:flex xl:gap-4" aria-label="Primary">
        {
          PRIMARY_NAV.map((link) => (
            <a
              href={link.href}
              class="nav-link inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap text-sm font-medium text-muted-foreground transition-colors hover:text-primary"
              data-nav-link
              {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
            >
              <Icon name={PRIMARY_NAV_ICONS[link.href] ?? 'navFeatures'} size={15} class="hidden 2xl:inline" />
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex shrink-0 items-center justify-end gap-1.5 sm:gap-2">
        <div class="hidden items-center sm:flex">
          <SlideRevealButton
            href={CHECKOUT_URL}
            class="hidden shrink-0 lg:inline-flex"
            ariaLabel={t.ui.checkoutAria}
            icon="arrowRight"
          >
            {HEADER_CTA_LABEL}
          </SlideRevealButton>
          <div class="nav-action-divider hidden items-center px-2 lg:flex xl:px-3" aria-hidden="true">
            <span class="block h-9 w-px bg-border"></span>
          </div>
          <AnimatedThemeSwitch size="md" ariaLabel={t.ui.themeLight} class="inline-flex shrink-0" />
        </div>

        <Sheet class="lg:hidden">
          <SheetTrigger
            class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg border border-border/80 bg-background/50 text-foreground transition-colors hover:bg-muted"
            aria-label={t.ui.menuOpen}
          >
            <Icon name="menu" size={20} />
          </SheetTrigger>
          <SheetContent side="right" class="flex w-[min(100vw-2rem,20rem)] flex-col gap-4">
            <SheetHeader>
              <SheetTitle>{t.site.name}</SheetTitle>
            </SheetHeader>
            <nav class="flex flex-col gap-1" aria-label="Mobile">
              {
                PRIMARY_NAV.map((link) => (
                  <a
                    href={link.href}
                    class="nav-link flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-primary"
                    data-nav-link
                    {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
                  >
                    <Icon name={PRIMARY_NAV_ICONS[link.href] ?? 'navFeatures'} size={16} />
                    {link.label}
                  </a>
                ))
              }
            </nav>
            <Button as="a" href={CHECKOUT_URL} variant="primary" class="w-full justify-center" aria-label={t.ui.checkoutAria}>
              <Icon name="arrowRight" size={18} />
              {HEADER_CTA_LABEL}
            </Button>
            <div class="flex justify-center pt-1">
              <AnimatedThemeSwitch size="sm" ariaLabel={t.ui.themeLight} />
            </div>
          </SheetContent>
        </Sheet>
      </div>
    </div>
  </div>
</header>
