---
import { t } from '../i18n';
import { Separator } from '@/components/starwind/separator';
import ShareButtons from './ShareButtons.astro';
import { getOrganizationSameAs } from '../config/seo';

interface Props {
  logoAlt?: string;
  shareUrl?: string;
  shareTitle?: string;
}

const { logoAlt = 'Aimbot – logo', shareUrl, shareTitle } = Astro.props;

const resourceLinks = [
  { href: '/status/', label: 'MW4 module status', ariaLabel: 'Live module status' },
  { href: '/products/mw4-cheats/aimbot/', label: 'MW4 aimbot module page', ariaLabel: 'Aimbot product page' },
  { href: '/products/mw4-cheats/esp/', label: 'MW4 ESP wallhack module', ariaLabel: 'ESP product page' },
  { href: '/support/', label: 'Loader and billing help', ariaLabel: 'Support and loader help' },
];

const legalLinks = [
  { href: '/about/', label: t.footer.about },
  { href: '/privacy/', label: t.footer.privacy },
  { href: '/terms/', label: t.footer.terms },
];

const externalLinks = [
  {
    href: 'https://en.wikipedia.org/wiki/Call_of_Duty:_Modern_Warfare_(2023_video_game)',
    label: 'Modern Warfare III on Wikipedia',
  },
  {
    href: 'https://www.microsoft.com/en-us/security/business/security-101/what-is-phishing',
    label: 'Microsoft security basics',
  },
  {
    href: 'https://support.activision.com/modern-warfare-iii',
    label: 'Official Activision MW support',
  },
];

const socialProfiles = getOrganizationSameAs();
---

<footer class="border-t border-border bg-muted/30 py-16">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <a href="/" class="inline-flex items-center gap-2.5 font-[family-name:var(--font-heading)] text-lg font-bold" aria-label={t.ui.homeAria}>
          <img src="/logo.svg" alt={logoAlt} width="32" height="32" class="rounded-md" />
          <span aria-hidden="true">MW4<span class="text-primary">Cheat</span></span>
        </a>
        <p class="text-sm text-muted-foreground">{t.footer.tagline}</p>
        {shareUrl && shareTitle ? (
          <ShareButtons url={shareUrl} title={shareTitle} class="share-buttons--compact" />
        ) : null}
      </div>

      <nav aria-label={t.footer.explore}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.explore}</p>
        <ul class="mt-3 space-y-2">
          {t.footer.exploreLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted-foreground hover:text-primary"
                aria-label={link.ariaLabel}
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.support}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.support}</p>
        <ul class="mt-3 space-y-2">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary" aria-label={link.ariaLabel}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.legal}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.legal}</p>
        <ul class="mt-3 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <nav class="mt-10" aria-label="Trusted external resources">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">External resources</p>
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
        {externalLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm text-muted-foreground hover:text-primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {
      socialProfiles.length > 0 && (
        <nav class="mt-6" aria-label="Social profiles">
          <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Follow</p>
          <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
            {socialProfiles.map((href) => (
              <li>
                <a href={href} class="text-sm text-muted-foreground hover:text-primary" target="_blank" rel="noopener noreferrer">
                  {new URL(href).hostname.replace(/^www\./, '')}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <Separator class="my-8" />
    <p class="text-left text-sm text-muted-foreground">
      &copy; {new Date().getFullYear()} {t.site.name} · {t.site.domain}
    </p>
  </div>
</footer>
