---
import type { BreadcrumbItem } from '../utils/schema';
import { breadcrumbAnchorLabel } from '../utils/linkLabels';
import {
  Breadcrumb,
  BreadcrumbItem as CrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/starwind/breadcrumb';

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
const currentPath = Astro.url.pathname;
---

<Breadcrumb class:list={['mb-4', className]}>
  <BreadcrumbList class={className?.includes('justify-center') ? 'justify-center' : undefined}>
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <>
          <CrumbItem>
            {isLast ? (
              <BreadcrumbPage>{item.name}</BreadcrumbPage>
            ) : (
              <BreadcrumbLink href={item.path} aria-label={breadcrumbAnchorLabel(item.name, item.path, currentPath)}>
                {item.name}
              </BreadcrumbLink>
            )}
          </CrumbItem>
          {!isLast && <BreadcrumbSeparator />}
        </>
      );
    })}
  </BreadcrumbList>
</Breadcrumb>
