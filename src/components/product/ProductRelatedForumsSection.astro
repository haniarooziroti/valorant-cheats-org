---
import { ROUTES } from '../../utils/path';
import type { ForumPost } from '../../data/forum';
import { Button } from '@/components/starwind/button';
import Icon from '../icons/Icon.astro';

interface Props {
  posts: ForumPost[];
  productName: string;
}

const { posts, productName } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="border-t border-border bg-muted/20 py-16 md:py-24" aria-labelledby="related-forums-heading">
      <div class="section-shell">
        <div class="section-header section-header--wide">
          <p class="section-header__eyebrow">Forums</p>
          <h2 id="related-forums-heading" class="section-header__title">
            Threads about {productName}
          </h2>
          <p class="section-header__subtitle">
            Player discussions on settings, checkout timing, and patch-week defaults—read before you change sliders.
          </p>
        </div>
        <ul class="mt-10 space-y-4">
          {posts.map((post) => (
            <li>
              <a
                class="block rounded-xl border border-border bg-card/60 p-5 transition hover:border-primary/40"
                href={`/forum/${post.slug}/`}
              >
                <span class="text-xs font-semibold uppercase tracking-wide text-primary">{post.category}</span>
                <p class="mt-2 font-semibold text-foreground">{post.title}</p>
                <p class="mt-1 text-sm text-muted-foreground">{post.excerpt}</p>
                <span class="mt-3 inline-flex items-center gap-1 text-xs text-muted-foreground">
                  View {post.commentsCount} replies on “{post.title.slice(0, 40)}{post.title.length > 40 ? '…' : ''}”{' '}
                  <Icon name="arrowRight" size={14} />
                </span>
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-10 flex justify-center">
          <Button as="a" href={ROUTES.forum} variant="outline" class="rounded-full">
            Browse all forums
            <Icon name="arrowRight" size={17} />
          </Button>
        </div>
      </div>
    </section>
  )
}
