---
import { HERO_VIDEO } from '../config/media';

const { poster, posterOnly } = HERO_VIDEO;
---

<div class="hero-video w-full">
  <div class="hero-video__frame rounded-xl border border-border bg-card p-2 shadow-sm">
    {posterOnly ? (
      <img
        class="hero-video__el aspect-[16/10] w-full rounded-lg object-cover"
        src={poster}
        alt="Valorant PC gameplay with tactical overlay preview on valorant-cheat.org"
        width={640}
        height={400}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    ) : (
      <>
        <video
          class="hero-video__el aspect-[16/10] w-full rounded-lg object-cover"
          data-hero-video-el
          poster={poster}
          playsinline
          muted
          loop
          preload="metadata"
          disablepictureinpicture
          disableremoteplayback
          controlslist="nodownload noplaybackrate noremoteplayback"
        >
          <source src={HERO_VIDEO.mp4} type="video/mp4" />
          <source src={HERO_VIDEO.webm} type="video/webm" />
        </video>
      </>
    )}
  </div>
</div>

{!posterOnly && (
  <script>
    import { initHeroVideo } from '../scripts/hero-video.ts';
    initHeroVideo();
  </script>
)}
