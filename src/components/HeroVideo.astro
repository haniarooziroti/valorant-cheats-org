---
import Icon from './icons/Icon.astro';
import { HERO_VIDEO } from '../config/media';

const { webm, mp4, poster } = HERO_VIDEO;
---

<div
  class="hero-video w-full"
  data-hero-video
  data-hero-duration={HERO_VIDEO.durationSec}
  data-hero-playing="false"
>
  <div class="hero-video__frame rounded-xl border border-border bg-card p-2 shadow-sm">
    <video
      class="hero-video__el aspect-[16/10] w-full rounded-lg object-cover"
      data-hero-video-el
      poster={poster}
      playsinline
      muted
      preload="metadata"
      disablepictureinpicture
      disableremoteplayback
      controlslist="nodownload noplaybackrate noremoteplayback"
    >
      <source src={mp4} type="video/mp4" />
      <source src={webm} type="video/webm" />
    </video>

    <button
      type="button"
      class="hero-video__overlay"
      data-hero-video-overlay
      aria-label="Play video"
    >
      <span class="hero-video__overlay-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z"></path>
        </svg>
      </span>
    </button>

    <div class="hero-video__controls" aria-label="Video playback controls">
      <button
        type="button"
        class="hero-video__btn hero-video__btn--toggle"
        data-hero-video-toggle
        aria-label="Play video"
        aria-pressed="false"
      >
        <span class="hero-video__icon hero-video__icon--play" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </span>
        <span class="hero-video__icon hero-video__icon--pause" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6 5h4v14H6V5zm8 0h4v14h-4V5z"></path>
          </svg>
        </span>
      </button>
      <button type="button" class="hero-video__btn" data-hero-video-back aria-label="Skip backward five seconds">
        <Icon name="chevronLeft" size={20} />
      </button>
      <button type="button" class="hero-video__btn" data-hero-video-forward aria-label="Skip forward five seconds">
        <Icon name="chevronRight" size={20} />
      </button>
    </div>
  </div>
</div>
